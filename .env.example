# Copy this file to .env for machine-specific settings.

# Shelly web UI host or IP, without http:// or a path.
SHELLY_IP=

# Cloud API keys are optional for the local setup check.

# OpenAI API Key
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# Gemini API key from a billing-enabled Google AI Studio project
# Get yours at: https://aistudio.google.com/api-keys
GEMINI_API_KEY=

# Optional: Set log level
LOG_LEVEL=INFO

# Optional: Override config file location
CONFIG_PATH=config.yaml
